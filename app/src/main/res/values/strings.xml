    <!-- What would stop the meter ringing, each with its mend -->
    <string name="setup_duraspeed">One step so the meter rings: the phone\'s DuraSpeed setting can shut Parked down, and its alarm with it. Open DuraSpeed, tap Open, and switch Parked on.</string>
    <string name="setup_duraspeed_open">Open DuraSpeed</string>
    <string name="setup_duraspeed_done">It\'s switched on</string>
    <string name="setup_notifications">Notifications are off for Parked, so the meter cannot ring.</string>
