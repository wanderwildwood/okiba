<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Location. It is used when a button is pressed, from the GPS alone, listened to for up to
      45 seconds until a position is sure enough, then let go. There is no INTERNET permission and no
      background location, so the position cannot leave the phone and is never read while
      the app is closed. COARSE is declared because Android 12 requires the pair to be asked
      for together; the app itself needs FINE.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      The parking meter, from 0.2.0. Still no INTERNET permission.
      Exact alarms, so the meter rings at its minute: SCHEDULE_EXACT_ALARM, on every Android
      version. It is given at install to an app built for Android 12, as this one is.
      USE_EXACT_ALARM counts only for apps built for Android 13 and later, so with
      SCHEDULE_EXACT_ALARM held back to Android 12 the meter had neither on a newer system
      and could ring minutes late.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- An alarm does not survive a restart: this is how a running meter's is set again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The ring is a notification; Android 13 and later ask for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The ringing screen over the lock screen, which is what turns the screen on. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The service that plays the ring until Stop is pressed, and keeps the phone awake for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <queries>
        <!-- Home, whose dark mode switch this app follows when Home is installed. -->
        <package android:name="com.wanderwildwood.iori" />
        <!-- DuraSpeed, the Kompakt's background manager: only to say whether it is there. -->
        <package android:name="com.mediatek.duraspeed" />
        <!-- The other apps that act on selected text, so the note field's selection menu can list them. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Which browsers the phone has, so a link never goes to the WebView test shell. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">
        <!-- Starts dark mode before the first screen is drawn. Holds no data. -->
        <provider
            android:name="com.wanderwildwood.okiba.ui.DarkModeInit"
            android:authorities="${applicationId}.darkmodeinit"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The ringing screen over the lock screen. Its own task, out of Recents. The screen
             waking can change its configuration; it is kept, not drawn again from scratch. -->
        <activity
            android:name=".meter.RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.wanderwildwood.okiba.ringing"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
            android:theme="@style/Theme.App" />

        <!-- Plays the ring while it rings, and only then. -->
        <service
            android:name=".meter.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".meter.MeterReceiver"
            android:exported="false" />

        <receiver
            android:name=".meter.SystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
